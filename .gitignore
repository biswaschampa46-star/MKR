# ─── dependencies ───
/node_modules
/.pnp
.pnp.*
/.yarn/*
!/.yarn/patches
!/.yarn/plugins
!/.yarn/releases
!/.yarn/versions

# ─── next.js / build output (generated) ───
/.next/
/out/
/build
/dist
/coverage
/.cache
/.turbo
*.tsbuildinfo
# next-env.d.ts is intentionally COMMITTED: it is regenerated by next dev/build,
# and keeping it lets a fresh clone run `npm run typecheck` before any build.

# ─── vercel (local CLI state only) ───
.vercel

# ─── environment files — never commit real secrets ───
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.development
.env.production
.env.test
!.env.example

# ─── logs / debug output ───
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── certificates / private keys ───
*.pem

# ─── OS junk ───
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ─── editor junk ───
.vscode/*
.idea/*
*.swp
*.swo

# ─── generated drizzle-kit output (real migrations live in /supabase/migrations) ───
/drizzle

# ─── local audit notes (machine-specific paths; delete these 2 lines to publish) ───
/AUDIT_REPORT.md
/IMPLEMENTATION_REPORT.md

# ─── local tooling / machine-specific ───
.freebuff/
