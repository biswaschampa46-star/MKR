# ─── MKR production environment — placeholders ONLY, never real secrets ───
# Copy to .env.local for local dev. In Vercel, add these under
# Project → Settings → Environment Variables (Production + Preview).

# ─── Database (required) ───
# Supabase Dashboard → Project Settings → Database → Connection string (pooler, port 5432)
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# ─── Supabase Auth + Storage (required) ───
# Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://[ref].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=[anon-public-key]
# Server-only. NEVER prefix with NEXT_PUBLIC_. Required on Vercel for admin uploads.
SUPABASE_SERVICE_ROLE_KEY=[service-role-key]

# ─── Admin panel (required) ───
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=[long-random-password]
# Server-only. Random 32+ char string for signing the admin session cookie.
ADMIN_SESSION_SECRET=[random-32-char-string]

# ─── AI assistant / OpenRouter (required for AI features) ───
# Server-only. Primary key used by /api/assistant + size recommendations.
OPENROUTER_API_KEY=[openrouter-key]
# Optional dedicated key for the admin product-description generator.
# Falls back to OPENROUTER_API_KEY when unset.
OPENROUTER_API_KEY_FOR_ADMINPANEL_PRODUCT=
# Model list, first = primary. Single model also works:
#   OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
# Comma-separated fallback list (preferred):
#   AI_MODELS=nvidia/nemotron-3.5-lightning:free, inclusionai/ling-3.0-flash-fin:free
OPENROUTER_MODEL=
AI_MODELS=
# Optional override for an OpenRouter-compatible endpoint.
AI_BASE_URL=
OPENROUTER_BASE_URL=

# ─── Site URL ───
# Production canonical URL. Set to your Vercel domain (https, no trailing slash).
# Falls back to VERCEL_URL automatically on preview deployments.
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app
# Server-side equivalent (backwards compatible, optional if NEXT_PUBLIC_SITE_URL is set).
SITE_URL=https://your-domain.vercel.app

# ─── Payments (optional — shown only when configured) ───
PAYMENT_BKASH_NUMBER=
PAYMENT_NAGAD_NUMBER=
PAYMENT_ROCKET_NUMBER=
